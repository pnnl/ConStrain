{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "workflow_name": {
            "type": "string"
        },
        "meta": {
            "type": "object",
            "properties": {
                "author": {
                    "type": "string"
                },
                "date": {
                    "type": "string",
                    "pattern": "^\\d{2}\/\\d{2}\/\\d{4}$"
                },
                "version": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                }
            },
            "required": [
                "author",
                "date",
                "version",
                "description"
            ],
            "additionalProperties": false
        },
        "imports": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "working_dir": {
            "type": "string"
        },
        "states": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/state"
            },
            "minProperties": 1
        }
    },
    "required": [
        "workflow_name",
        "meta",
        "imports",
        "states"
    ],
    "additionalProperties": false,
    "$defs": {
        "flagString": {
            "enum": [
                "True",
                "False"
            ]
        },
        "jsonValue": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "number"
                },
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/jsonValue"
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/jsonValue"
                    }
                }
            ]
        },
        "embeddedMethodCall": {
            "type": "object",
            "properties": {
                "Type": {
                    "const": "Embedded MethodCall"
                },
                "MethodCall": {
                    "type": "string"
                },
                "Parameters": {
                    "$ref": "#/$defs/parameters"
                }
            },
            "required": [
                "Type",
                "MethodCall",
                "Parameters"
            ],
            "additionalProperties": false
        },
        "parameterValue": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "number"
                },
                {
                    "type": "boolean"
                },
                {
                    "$ref": "#/$defs/embeddedMethodCall"
                }
            ]
        },
        "parameters": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/parameterValue"
                    }
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/parameterValue"
                    }
                }
            ]
        },
        "payloads": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/jsonValue"
            }
        },
        "choicePredicate": {
            "type": "object",
            "properties": {
                "Value": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "number"
                        },
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "Equals": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "number"
                        },
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "Next": {
                    "type": "string"
                }
            },
            "required": [
                "Value",
                "Equals",
                "Next"
            ],
            "additionalProperties": false
        },
        "logicalAllChoice": {
            "type": "object",
            "properties": {
                "ALL": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/choicePredicate"
                    },
                    "minItems": 1
                },
                "AND": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/choicePredicate"
                    },
                    "minItems": 1
                },
                "Next": {
                    "type": "string"
                }
            },
            "required": [
                "Next"
            ],
            "oneOf": [
                {
                    "required": [
                        "ALL"
                    ]
                },
                {
                    "required": [
                        "AND"
                    ]
                }
            ],
            "additionalProperties": false
        },
        "logicalAnyChoice": {
            "type": "object",
            "properties": {
                "ANY": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/choicePredicate"
                    },
                    "minItems": 1
                },
                "Next": {
                    "type": "string"
                }
            },
            "required": [
                "ANY",
                "Next"
            ],
            "additionalProperties": false
        },
        "logicalNoneChoice": {
            "type": "object",
            "properties": {
                "NONE": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/choicePredicate"
                    },
                    "minItems": 1
                },
                "Next": {
                    "type": "string"
                }
            },
            "required": [
                "NONE",
                "Next"
            ],
            "additionalProperties": false
        },
        "state": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "Type": {
                            "const": "MethodCall"
                        },
                        "MethodCall": {
                            "type": "string"
                        },
                        "Parameters": {
                            "$ref": "#/$defs/parameters"
                        },
                        "Payloads": {
                            "$ref": "#/$defs/payloads"
                        },
                        "Next": {
                            "type": "string"
                        },
                        "Start": {
                            "$ref": "#/$defs/flagString"
                        },
                        "End": {
                            "$ref": "#/$defs/flagString"
                        }
                    },
                    "required": [
                        "Type",
                        "MethodCall",
                        "Parameters"
                    ],
                    "allOf": [
                        {
                            "if": {
                                "properties": {
                                    "End": {
                                        "const": "True"
                                    }
                                },
                                "required": [
                                    "End"
                                ]
                            },
                            "then": true,
                            "else": {
                                "required": [
                                    "Next"
                                ]
                            }
                        }
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "Type": {
                            "const": "Choice"
                        },
                        "Choices": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/choice"
                            },
                            "minItems": 1
                        },
                        "Default": {
                            "type": "string"
                        },
                        "Start": {
                            "$ref": "#/$defs/flagString"
                        },
                        "End": {
                            "$ref": "#/$defs/flagString"
                        }
                    },
                    "required": [
                        "Type",
                        "Choices",
                        "Default"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "choice": {
            "oneOf": [
                {
                    "$ref": "#/$defs/choicePredicate"
                },
                {
                    "$ref": "#/$defs/logicalAllChoice"
                },
                {
                    "$ref": "#/$defs/logicalAnyChoice"
                },
                {
                    "$ref": "#/$defs/logicalNoneChoice"
                }
            ]
        }
    }
}
