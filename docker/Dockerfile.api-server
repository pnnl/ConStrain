# Dockerfile for ConStrain Backend API Server
# Unified REST API for verification, reporting, and workflow execution
# This consolidates the verification, reporting, and workflow services

FROM python:3.10-slim as builder

WORKDIR /app

# Install build dependencies needed for compiling Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install poetry for dependency management
RUN pip install --no-cache-dir poetry poetry-plugin-export

# Copy only dependency files first (for Docker layer caching)
COPY pyproject.toml ./

# Export dependencies to requirements.txt (exclude dev and desktop dependencies)
# This reduces image size and removes unnecessary packages like PyQt6
RUN poetry export -f requirements.txt --output requirements.txt --without-hashes --without dev && \
    sed -i '/^pyqt6/d' requirements.txt && \
    sed -i '/^streamlit/d' requirements.txt

# Install all dependencies to prefix
RUN pip install --no-cache-dir \
    --prefix=/install \
    --no-warn-script-location \
    packaging \
    -r requirements.txt

# Final stage - minimal runtime image
FROM python:3.10-slim

WORKDIR /app

# Copy only installed packages from builder stage (much smaller than full /usr)
COPY --from=builder /install /usr/local

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uvicorn (web server) if not in main dependencies
RUN pip install --no-cache-dir uvicorn[standard]==0.24.0 packaging

# Copy project source code
COPY constrain/ ./constrain/
COPY resources/ ./resources/
COPY docker/run_verification.py ./
COPY docker/run_reporting.py ./

# Set Python path for imports
ENV PYTHONPATH=/app:${PYTHONPATH}

# Create necessary directories for data and results
RUN mkdir -p /data/data /data/results /data/verification_cases /data/schema

# Set default output directory (can be overridden via env var)
ENV OUTPUT_DIR=/data/results
ENV LOG_LEVEL=INFO

# Health check - verify API is responding
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose API port
EXPOSE 8000

# Run the FastAPI application
CMD ["uvicorn", "constrain.app.ai_workflow_server:app", "--host", "0.0.0.0", "--port", "8000"]
