# Dockerfile for ConStrain AI Workflow Web UI
# FastAPI-based web interface with Jinja2 templates
# This replaces the Streamlit service and removes docker socket dependency

FROM python:3.10-slim AS builder

WORKDIR /app

# Install build dependencies needed for compiling Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install poetry for dependency management
RUN pip install --no-cache-dir poetry poetry-plugin-export

# Copy only dependency files
COPY pyproject.toml ./

# Export dependencies to requirements.txt, excluding dev tools and PyQt6
RUN poetry export -f requirements.txt --output requirements.txt --without-hashes --without dev && \
    sed -i '/^pyqt6/d' requirements.txt && \
    sed -i '/^streamlit/d' requirements.txt

# Install all dependencies to prefix
RUN pip install --no-cache-dir \
    --prefix=/install \
    --no-warn-script-location \
    packaging \
    -r requirements.txt

# Final stage - lightweight runtime image
FROM python:3.10-slim

WORKDIR /app

# Copy only installed packages from builder stage
COPY --from=builder /install /usr/local

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install patched packaging toolchain and uvicorn runtime.
RUN pip install --no-cache-dir --upgrade \
    "setuptools>=78.1.1,<81" \
    "wheel>=0.46.2" \
    uvicorn[standard]==0.24.0 \
    packaging

# Remove stale dist-info left by the builder layer so SBOM scanners see only the active versions.
RUN python - <<'PY'
import glob
import pathlib
import shutil
import setuptools
import wheel

current_versions = {
    'setuptools': setuptools.__version__,
    'wheel': wheel.__version__,
}

for package, version in current_versions.items():
    pattern = f'/usr/local/lib/python*/site-packages/{package}-*.dist-info'
    for path_str in glob.glob(pattern):
        path = pathlib.Path(path_str)
        if version not in path.name:
            shutil.rmtree(path)
PY

# Copy web UI and core modules
COPY constrain/ ./constrain/
COPY resources/ ./resources/
COPY docs/ ./docs/
# Set Python path
ENV PYTHONPATH=/app

# Create directories for volumes
RUN mkdir -p /data/results /data/uploads

# Health check - verify HTTP endpoint is responsive
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=5).read()" || exit 1

# Default port for web UI
EXPOSE 8000

# Default environment variables
ENV LOG_LEVEL=INFO
ENV CONSTRAIN_API_BASE_URL=http://api-server:8000
ENV CONSTRAIN_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Run FastAPI application with Uvicorn
CMD ["uvicorn", "constrain.app.ai_workflow_ui:app", "--host", "0.0.0.0", "--port", "8000"]
